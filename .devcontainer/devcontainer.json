{
  "name": "Web Java - UFSCar",

  "image": "mcr.microsoft.com/devcontainers/java:3-21-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "none",
      "installMaven": "true",
      "installGradle": "false"
    },

    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },

  "forwardPorts": [8080],

  "portsAttributes": {
    "8080": {
      "label": "Tomcat",
      "onAutoForward": "notify"
    }
  },

  "postCreateCommand": "bash .devcontainer/setup-tomcat.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack"
      ]
    }
  }
}